# ============================================
# .env PRODUCTION - RÉSEAU LOCAL
# ============================================
# Configuration pour serveur en réseau local d'entreprise
# Accessible via : http://192.168.x.x OU https://intranet.local

APP_NAME="Gestion Budgétaire"
APP_ENV=production
APP_KEY=base64:GENERER_AVEC_php_artisan_key:generate
APP_DEBUG=false

# ============================================
# URL DE L'APPLICATION
# ============================================

# Option 1 : HTTP (réseau local sans certificat SSL)
APP_URL=http://192.168.1.100
# OU
# APP_URL=http://intranet.entreprise.local

# Option 2 : HTTPS (avec certificat auto-signé ou Let's Encrypt)
# APP_URL=https://intranet.entreprise.local

# ============================================
# BASE DE DONNÉES
# ============================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# OU si serveur BDD distant
# DB_HOST=192.168.1.50
DB_PORT=3306
DB_DATABASE=gestion_budgetaire_prod
DB_USERNAME=app_user
DB_PASSWORD=mot_de_passe_fort_securise

# ============================================
# SESSION - CONFIGURATION PRODUCTION LOCALE
# ============================================

# Driver : database recommandé en production
SESSION_DRIVER=database
# OU redis si disponible pour meilleures performances
# SESSION_DRIVER=redis

# Durée : 30 minutes (sécurité renforcée)
SESSION_LIFETIME=30

# Expiration à la fermeture du navigateur
SESSION_EXPIRE_ON_CLOSE=true

# ⚠️ IMPORTANT : Adapter selon HTTP ou HTTPS
# Si HTTP (pas de certificat SSL)
SESSION_SECURE_COOKIE=false
# Si HTTPS (avec certificat SSL)
# SESSION_SECURE_COOKIE=true

# Sécurité HTTP
SESSION_HTTP_ONLY=true

# SameSite : lax pour réseau local (plus flexible que strict)
SESSION_SAME_SITE=lax

# Chiffrement : true en production
SESSION_ENCRYPT=true

# Domaine : laisser vide pour réseau local
# OU spécifier si vous avez un domaine interne
SESSION_DOMAIN=
# SESSION_DOMAIN=.entreprise.local

# ============================================
# CACHE & PERFORMANCE
# ============================================

# File pour petit serveur, Redis pour performance
CACHE_DRIVER=file
# OU pour meilleures performances
# CACHE_DRIVER=redis

# Queue pour traitement asynchrone
QUEUE_CONNECTION=database
# OU
# QUEUE_CONNECTION=redis

# ============================================
# REDIS (Optionnel mais recommandé)
# ============================================

# Si vous utilisez Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# Si Redis activé, utiliser pour cache et sessions
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis

# ============================================
# MAIL CONFIGURATION
# ============================================

# Configuration SMTP de votre entreprise
MAIL_MAILER=smtp
MAIL_HOST=smtp.entreprise.local
MAIL_PORT=587
MAIL_USERNAME=noreply@entreprise.local
MAIL_PASSWORD=mot_de_passe_email
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@entreprise.local
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# LOGS ET MONITORING
# ============================================

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAYS=14

# Désactiver les logs de dépréciation en production
LOG_DEPRECATIONS_CHANNEL=null

# ============================================
# SÉCURITÉ PRODUCTION
# ============================================

# Limite de tentatives de connexion
THROTTLE_LOGIN_ATTEMPTS=5
THROTTLE_LOGIN_DECAY=60

# ============================================
# STOCKAGE
# ============================================

FILESYSTEM_DISK=local

# ============================================
# BROADCASTING (Optionnel)
# ============================================

BROADCAST_DRIVER=log

# ============================================
# NOTES IMPORTANTES
# ============================================

# HTTPS (Recommandé pour Production)
# ==================================
# Même en réseau local, HTTPS est recommandé pour :
# - Sécurité des mots de passe
# - Protection des données sensibles
# - Conformité RGPD/sécurité
#
# Solutions pour HTTPS en réseau local :
# 1. Certificat auto-signé (gratuit, alerte navigateur)
# 2. CA interne d'entreprise (gratuit, nécessite config)
# 3. Let's Encrypt avec domaine interne (gratuit)
#
# Configuration Apache/Nginx requise pour HTTPS

# HTTP (Si pas de HTTPS disponible)
# ==================================
# Si vous devez rester en HTTP :
# - SESSION_SECURE_COOKIE=false
# - Limiter l'accès réseau (firewall)
# - VPN pour accès externe
# - Authentification forte (2FA)

# PERFORMANCES
# ============
# Pour > 50 utilisateurs simultanés :
# - Installer Redis
# - SESSION_DRIVER=redis
# - CACHE_DRIVER=redis
# - QUEUE_CONNECTION=redis
#
# Pour serveur modeste :
# - SESSION_DRIVER=database
# - CACHE_DRIVER=file
# - Suffit pour < 50 utilisateurs

# SAUVEGARDES
# ===========
# Configurez des sauvegardes automatiques :
# - Base de données (mysqldump)
# - Fichiers uploadés (storage/)
# - Configuration (.env sauvegardé séparément)