# ============================================
# .env.local - ENVIRONNEMENT DE DÉVELOPPEMENT
# ============================================
# À utiliser sur votre machine locale

APP_NAME="Gestion Budgétaire"
APP_ENV=local
APP_KEY=base64:GENERER_AVEC_php_artisan_key:generate
APP_DEBUG=true
APP_URL=http://localhost:8000

# ============================================
# BASE DE DONNÉES
# ============================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestion_budgetaire
DB_USERNAME=root
DB_PASSWORD=

# ============================================
# SESSION - CONFIGURATION LOCALE (HTTP)
# ============================================

# Driver (file est le plus simple pour le dev)
SESSION_DRIVER=file

# Durée de session longue en dev (120 minutes)
SESSION_LIFETIME=120

# Ne pas expirer à la fermeture en dev
SESSION_EXPIRE_ON_CLOSE=false

# ⚠️ IMPORTANT : FALSE car pas de HTTPS en local
SESSION_SECURE_COOKIE=false

SESSION_HTTP_ONLY=true

# LAX en développement (plus permissif)
SESSION_SAME_SITE=lax

# Désactiver le chiffrement en dev pour faciliter le debug
SESSION_ENCRYPT=false

# Laisser vide
SESSION_DOMAIN=

# ============================================
# CACHE - SIMPLE POUR LE DEV
# ============================================

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# ============================================
# MAIL - UTILISER MAILTRAP OU LOG
# ============================================

MAIL_MAILER=log
# Ou utiliser Mailtrap pour tester les emails
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your_mailtrap_username
# MAIL_PASSWORD=your_mailtrap_password
# MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# LOGS - VERBOSE EN DEV
# ============================================

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ============================================
# REDIS (Optionnel en dev)
# ============================================

# Décommenter si vous utilisez Redis en local
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ============================================
# NOTES POUR LE DÉVELOPPEMENT
# ============================================

# ✅ Configuré pour HTTP (localhost)
# ✅ Debug activé
# ✅ Sessions longues (120 min)
# ✅ Mails en log (pas envoyés)
# ✅ Cache simple (file)

# Pour démarrer :
# 1. php artisan key:generate
# 2. php artisan migrate
# 3. php artisan serve