# ============================================
# CONFIGURATION APPLICATION
# ============================================

APP_NAME="Gestion Budgétaire"
APP_ENV=production
APP_KEY=base64:REMPLACER_PAR_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://votre-domaine.com

# ============================================
# BASE DE DONNÉES
# ============================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nom_de_votre_base
DB_USERNAME=votre_utilisateur
DB_PASSWORD=votre_mot_de_passe

# ============================================
# SÉCURITÉ SESSION
# ============================================

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_ENCRYPT=true

# ============================================
# CACHE & PERFORMANCE
# ============================================

CACHE_DRIVER=file
QUEUE_CONNECTION=database

# Pour meilleures performances avec Redis (optionnel)
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ============================================
# MAIL (Optionnel)
# ============================================

MAIL_MAILER=smtp
MAIL_HOST=smtp.exemple.com
MAIL_PORT=587
MAIL_USERNAME=votre_email@exemple.com
MAIL_PASSWORD=votre_mot_de_passe_email
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@exemple.com
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# SÉCURITÉ ADDITIONNELLE
# ============================================

# Désactiver l'autocomplétion
AUTOCOMPLETE_OFF=true

# Logs et Monitoring
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ============================================
# NOTES POUR LE DÉPLOIEMENT
# ============================================

# 1. Copier ce fichier : cp .env.example .env
# 2. Générer APP_KEY : php artisan key:generate
# 3. Remplir les vraies valeurs de BDD
# 4. Configurer les credentials mail si nécessaire
# 5. Ajuster SESSION_SECURE_COOKIE=true uniquement si HTTPS
# 6. Créer la table sessions : php artisan session:table && php artisan migrate